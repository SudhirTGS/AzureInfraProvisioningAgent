# Copy this file to .env and fill in real values. .env is gitignored.

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Azure (service principal) ---
# Reserved for future direct Azure SDK calls from the Python app. NOT used by
# GitHub Actions, which authenticates via OIDC federated credentials instead
# (see README.md). Safe to leave blank for local development.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- GitHub (target repo for generated Terraform + PRs) ---
# Only required once SUBMIT_REQUIREMENTS_MODE=full_pr. Leave as placeholders
# until you have a real target infra repo.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=your-org
GITHUB_REPO_NAME=your-infra-repo
GITHUB_BASE_BRANCH=main
GITHUB_PR_BRANCH_PREFIX=infra-request/

# --- Terraform remote state backend (azurerm) ---
# One-time manual Azure setup required first — see README.md.
TERRAFORM_STATE_RESOURCE_GROUP=rg-tfstate
TERRAFORM_STATE_STORAGE_ACCOUNT=sttfstateexample
TERRAFORM_STATE_CONTAINER=tfstate
TERRAFORM_AZURERM_PROVIDER_VERSION=~> 3.90

# --- Submission behavior ---
# stub        = log the validated payload only (default, safe for local testing)
# render_only = also render Terraform files to ./rendered_output/<slug>/ for review
# full_pr     = also open a real GitHub PR (requires GITHUB_* above)
SUBMIT_REQUIREMENTS_MODE=stub

# --- Misc ---
SESSION_TTL_MINUTES=60
